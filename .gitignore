# Dependencies
node_modules/
.venv/
venv/

# Build output
dist/
build/
coverage/
*.log

# The Next.js app in landing/ keeps only generated state on disk: .next/ build
# output, node_modules/, and the auto-generated next-env.d.ts. The authored
# source lives on the feature/landing-client-theater branch. Anchored with a
# leading slash so a feature folder named "landing" deeper in the tree is
# still tracked.
/landing/

# Runtime data: the SQLite database and its audit mirror are generated state,
# not source. The schema in backend/dsr/db/schema.sql is the source of truth.
data/
*.db
*.db-wal
*.db-shm

# Git worktrees used for isolated per-workflow development
.worktrees/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/

# Agent and tooling state
# .commandcode/ is the commandcode CLI's own directory.
# .scratch/ is where agents are told to put scratch files (see
# orchestration/make_build_briefs.py and docs/agents/issue-tracker.md); the
# archived local-dev-loop map lives there and is history only.
.commandcode/
.scratch/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
