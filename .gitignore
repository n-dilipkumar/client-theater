# Dependencies
node_modules/
.venv/
venv/

# Build output
dist/
build/
coverage/
*.log

# Local build scratch from a Next.js marketing page that was developed here and
# then removed: .next/ build output, node_modules/, and the auto-generated
# next-env.d.ts. No authored source remains, and nothing in the repository
# references the directory. Anchored with a leading slash so a feature folder
# named "landing" deeper in the tree is still tracked.
/landing/

# Runtime data: the SQLite database and its audit mirror are generated state,
# not source. The schema in backend/dsr/db/schema.sql is the source of truth.
data/
*.db
*.db-wal
*.db-shm

# Git worktrees used for isolated per-workflow development
.worktrees/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ruff_cache/

# Agent and tooling state
# .commandcode/ is the commandcode CLI's own directory.
# .scratch/ is where agents are told to put scratch files (see
# orchestration/make_build_briefs.py and docs/agents/issue-tracker.md); the
# archived local-dev-loop map lives there and is history only.
.commandcode/
.scratch/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# pytest writes a SQLite coverage database at backend/.coverage. The coverage/
# rule above carries a trailing slash and so matches only the directory, which
# left the file itself untracked-but-visible. An agent that staged by path could
# still sweep it in by accident.
.coverage
.coverage.*
